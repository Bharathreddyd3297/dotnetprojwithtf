    <script>
            function calculateInvestment() {
                const monthly = parseFloat(document.getElementById('monthlyInv').value);
                const years = parseInt(document.getElementById('timeHorizon').value);

                document.getElementById('invDisplay').innerText = '₹' + monthly.toLocaleString('en-IN');
                document.getElementById('timeDisplay').innerText = years + (years === 1 ? ' Year' : ' Years');

                const months = years * 12;
                const totalInv = monthly * months;
                document.getElementById('totalInvested').innerText = '₹' + Math.round(totalInv).toLocaleString('en-IN');

                // Compound interest calculation assuming 14% annual return compounded monthly
                const rateMonthly = 0.14 / 12;
                let futureValue = 0;
                if (rateMonthly > 0) {
                    futureValue = monthly * ((Math.pow(1 + rateMonthly, months) - 1) / rateMonthly) * (1 + rateMonthly);
                } else {
                    futureValue = totalInv;
                }

                const estReturns = futureValue - totalInv;
                document.getElementById('totalReturns').innerText = '₹' + Math.round(estReturns > 0 ? estReturns : 0).toLocaleString('en-IN');
                document.getElementById('totalValue').innerText = '₹' + Math.round(futureValue > 0 ? futureValue : totalInv).toLocaleString('en-IN');
            }

            function handleSignup(e) {
                e.preventDefault();
                const email = document.getElementById('signupEmail').value;
                if (email) {
                    const formContainer = e.target;
                    formContainer.innerHTML = `
                        <div class="bg-rose-950 border border-rose-500/50 p-4 rounded-xl text-rose-400 text-sm font-medium flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-lg"></i>
                            <span>Thanks for enquiring about the Groww page.</span>
                        </div>
                    `;
                }
            }

            // Initialize calculation on load
            window.onload = function() {
                calculateInvestment();
            };
    </script>
